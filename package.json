{
  "name": "tf2-trading-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TF2 metal/key arbitrage bot scaffold",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "once": "node --env-file-if-exists=.env src/index.ts --once",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc",
    "dump-listings": "node --env-file-if-exists=.env src/tools/dump-listings.ts",
    "report": "node src/tools/report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/steam-totp": "^2.1.2",
    "@types/steam-tradeoffer-manager": "^2.11.2",
    "@types/steam-user": "^5.1.1",
    "@types/steamcommunity": "^3.50.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "steam-totp": "^2.1.2",
    "steam-tradeoffer-manager": "^2.13.0",
    "steam-user": "^5.3.0",
    "steamcommunity": "^3.50.3"
  }
}
