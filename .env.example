# mock = bundled fixture market (no credentials needed); backpacktf = live classifieds
DATA_SOURCE=mock
BPTF_TOKEN=

# Our own SteamID64, so we never trade against our own listings
STEAM_ID=

# Bot Steam login, for the live executor (not implemented yet; leave blank for dry runs).
# The two secrets come from SDA's maFiles/<SteamID>.maFile.
STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=

# Comma-separated SKUs to scan. 5021;6 = Mann Co. Supply Crate Key
WATCHLIST=5021;6

# Risk controls
MIN_PROFIT_SCRAP=1
MAX_TRADE_COST_REF=200
MAX_LISTING_AGE_S=1800
POLL_INTERVAL_S=60

# Only paper trading is implemented. Live trading needs src/execution/steam.ts filled in.
DRY_RUN=true
PAPER_START_REF=150
PAPER_START_KEYS=2
